-- UPDATE
local function Update()
    Count = math.clamp(Count, 0, TARGET)

    Counter.Text = string.format("%02d", Count)
    Percent.Text = math.floor(Count / TARGET * 100) .. "%"

    Tween(Bar, 0.3, {
        Size = UDim2.fromScale(Count / TARGET, 1)
    })

    if Count >= TARGET then
        Completed = true
        Status.Text = "●  REQUIREMENTS VERIFIED"
        Status.TextColor3 = Theme.Green

        MainStroke.Color = Theme.Green
        ButtonStroke.Color = Theme.Green

        Tween(Activate, 0.3, {
            BackgroundColor3 = Color3.fromRGB(35, 90, 72),
            TextColor3 = Theme.White
        })
    end
end

-- REJECT ANIMATION
local function Reject()
    if Running then return end

    local Original = Main.Position

    MainStroke.Color = Theme.Red
    Status.Text = "●  ACCESS DENIED — 19 REQUIRED"
    Status.TextColor3 = Theme.Red

    for i = 1, 4 do
        local offset = i % 2 == 0 and 9 or -9
        Main.Position = Original + UDim2.fromOffset(offset, 0)
        task.wait(0.045)
    end

    Main.Position = Original

    task.delay(1.3, function()
        if not Completed then
            MainStroke.Color = Theme.Purple
            Status.Text = "●  WAITING FOR REQUIREMENTS"
            Status.TextColor3 = Theme.Muted
        end
    end)
end

-- HOOK
if not hookmetamethod or not getnamecallmethod then
    Status.Text = "●  HOOK NOT SUPPORTED"
    return
end

local OldNamecall

OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local Method = getnamecallmethod()

    if self == Event and Method == "InvokeServer" then
        local Results = table.pack(OldNamecall(self, ...))

        if Results[1] == true and not Completed then
            Count += 1
            Update()
        end

        return table.unpack(Results, 1, Results.n)
    end

    return OldNamecall(self, ...)
end))

-- ACTIVATION
Activate.Activated:Connect(function()
    if not Completed then
        Reject()
        return
    end

    if Running then return end
    Running = true

    Status.Text = "●  INITIALIZING..."
    Status.TextColor3 = Theme.Purple

    local Success, Error = pcall(function()
        local Source = game:HttpGet(URL)
        local Script = loadstring(Source)
        assert(Script, "Compilation failed")
        Script()
    end)

    if Success then
        Status.Text = "●  SCRIPT INITIALIZED"
        Status.TextColor3 = Theme.Green
    else
        Running = false
        Status.Text = "●  INITIALIZATION FAILED"
        Status.TextColor3 = Theme.Red
        warn("[NHAT HUB]", Error)
    end
end)

-- DRAG HEADER
local Dragging = false
local DragStart
local StartPosition

Header.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position
    end
end)

UIS.InputChanged:Connect(function(Input)
    if Dragging and (
        Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch
    ) then
        local Delta = Input.Position - DragStart
        Main.Position = StartPosition + UDim2.fromOffset(
            Delta.X,
            Delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then
        Dragging = false
    end
end)

